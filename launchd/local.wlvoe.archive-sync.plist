<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.wlvoe.archive-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/chih-chun/Library/Application Support/2027WLVOE/sync_archive.py</string>
  </array>
  <!-- 每天 21:00 (本機時間)；錯過時 (闔上/關機) 在下次喚醒時補跑 -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <!-- 登入時也跑一次，補齊關機期間漏掉的報 -->
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/wlvoe-archive-sync.out</string>
  <key>StandardErrorPath</key><string>/tmp/wlvoe-archive-sync.err</string>
</dict>
</plist>
